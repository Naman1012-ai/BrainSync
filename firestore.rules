rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ══════════════════════════════════════════════════════════════
    // HELPER FUNCTIONS
    // ══════════════════════════════════════════════════════════════

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function getOrg(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)).data;
    }

    function isMember(orgId) {
      return isAuthenticated()
          && request.auth.uid in getOrg(orgId).memberIds;
    }

    function isLeader(orgId) {
      return isAuthenticated()
          && getOrg(orgId).leaderId == request.auth.uid;
    }

    function isIdeationPhase(orgId) {
      return getOrg(orgId).status == 'ideation';
    }

    function isProjectPhase(orgId) {
      return getOrg(orgId).status == 'project';
    }

    function isValidLength(value, minLen, maxLen) {
      return value is string
          && value.size() >= minLen
          && value.size() <= maxLen;
    }

    function isUnchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    // ══════════════════════════════════════════════════════════════
    // USERS COLLECTION
    // ══════════════════════════════════════════════════════════════

    match /users/{uid} {
      allow read: if isAuthenticated();
      allow create: if isOwner(uid)
                    && request.resource.data.uid == uid
                    && isValidLength(request.resource.data.displayName, 1, 50)
                    && request.resource.data.email is string
                    && request.resource.data.keys().hasAll(['uid', 'displayName', 'email', 'createdAt']);
      allow update: if isOwner(uid)
                    && isUnchanged('uid')
                    && isUnchanged('email')
                    && isUnchanged('createdAt');
      allow delete: if false;
    }

    // ══════════════════════════════════════════════════════════════
    // ORGANIZATIONS COLLECTION
    // ══════════════════════════════════════════════════════════════

    match /organizations/{orgId} {
      allow read: if isAuthenticated()
                  && request.auth.uid in resource.data.memberIds;
      allow create: if isAuthenticated()
                    && request.resource.data.leaderId == request.auth.uid
                    && request.auth.uid in request.resource.data.memberIds
                    && request.resource.data.status == 'ideation'
                    && request.resource.data.selectedIdeaId == null
                    && request.resource.data.projectName == null
                    && isValidLength(request.resource.data.name, 1, 100)
                    && request.resource.data.inviteCode is string
                    && request.resource.data.keys().hasAll([
                         'name', 'inviteCode', 'leaderId', 'memberIds',
                         'status', 'selectedIdeaId', 'projectName',
                         'createdAt', 'updatedAt'
                       ]);
      allow update: if isAuthenticated()
                    && (
                      (request.auth.uid in request.resource.data.memberIds
                       && isUnchanged('leaderId')
                       && isUnchanged('inviteCode')
                       && isUnchanged('status')
                       && isUnchanged('selectedIdeaId')
                       && isUnchanged('createdAt'))
                      ||
                      (request.auth.uid in resource.data.memberIds
                       && isUnchanged('leaderId')
                       && isUnchanged('inviteCode')
                       && isUnchanged('status')
                       && isUnchanged('selectedIdeaId')
                       && isUnchanged('createdAt'))
                      ||
                      (isLeader(orgId)
                       && isUnchanged('inviteCode')
                       && isUnchanged('createdAt'))
                    );
      allow delete: if isLeader(orgId);
    }

    // ══════════════════════════════════════════════════════════════
    // IDEAS COLLECTION
    // ══════════════════════════════════════════════════════════════

    match /ideas/{ideaId} {
      allow read: if isMember(resource.data.orgId);
      allow create: if isMember(request.resource.data.orgId)
                    && isIdeationPhase(request.resource.data.orgId)
                    && request.resource.data.authorId == request.auth.uid
                    && isValidLength(request.resource.data.title, 1, 150)
                    && isValidLength(request.resource.data.description, 1, 5000)
                    && isValidLength(request.resource.data.problemStatement, 1, 3000)
                    && request.resource.data.proposedSolution is string
                    && request.resource.data.proposedSolution.size() <= 3000
                    && request.resource.data.voteCount == 0
                    && request.resource.data.commentCount == 0
                    && request.resource.data.suggestionCount == 0
                    && request.resource.data.isDeleted == false
                    && request.resource.data.keys().hasAll([
                         'orgId', 'title', 'description', 'problemStatement',
                         'proposedSolution', 'authorId', 'authorName',
                         'voteCount', 'commentCount', 'suggestionCount',
                         'isDeleted', 'createdAt', 'updatedAt'
                       ]);
      allow update: if isMember(resource.data.orgId)
                    && isUnchanged('orgId')
                    && isUnchanged('authorId')
                    && isUnchanged('authorName')
                    && isUnchanged('createdAt')
                    && (
                      (isOwner(resource.data.authorId)
                       && isIdeationPhase(resource.data.orgId))
                      ||
                      (isUnchanged('title')
                       && isUnchanged('description')
                       && isUnchanged('problemStatement')
                       && isUnchanged('proposedSolution')
                       && isUnchanged('isDeleted'))
                      ||
                      (request.resource.data.isDeleted == true
                       && (isOwner(resource.data.authorId) || isLeader(resource.data.orgId)))
                    );
      allow delete: if false;
    }

    // ══════════════════════════════════════════════════════════════
    // COMMENTS COLLECTION
    // ══════════════════════════════════════════════════════════════

    match /comments/{commentId} {
      allow read: if isMember(resource.data.orgId);
      allow create: if isMember(request.resource.data.orgId)
                    && isIdeationPhase(request.resource.data.orgId)
                    && request.resource.data.authorId == request.auth.uid
                    && isValidLength(request.resource.data.content, 1, 3000)
                    && request.resource.data.keys().hasAll([
                         'ideaId', 'orgId', 'content', 'authorId',
                         'authorName', 'createdAt', 'updatedAt'
                       ]);
      allow update: if isMember(resource.data.orgId)
                    && isOwner(resource.data.authorId)
                    && isUnchanged('ideaId')
                    && isUnchanged('orgId')
                    && isUnchanged('authorId')
                    && isUnchanged('authorName')
                    && isUnchanged('createdAt')
                    && isValidLength(request.resource.data.content, 1, 3000);
      allow delete: if isMember(resource.data.orgId)
                    && (isOwner(resource.data.authorId) || isLeader(resource.data.orgId));
    }

    // ══════════════════════════════════════════════════════════════
    // SUGGESTIONS COLLECTION
    // ══════════════════════════════════════════════════════════════

    match /suggestions/{suggestionId} {
      allow read: if isMember(resource.data.orgId);
      allow create: if isMember(request.resource.data.orgId)
                    && isIdeationPhase(request.resource.data.orgId)
                    && request.resource.data.authorId == request.auth.uid
                    && isValidLength(request.resource.data.content, 1, 3000)
                    && request.resource.data.keys().hasAll([
                         'ideaId', 'orgId', 'content', 'authorId',
                         'authorName', 'createdAt', 'updatedAt'
                       ]);
      allow update: if isMember(resource.data.orgId)
                    && isOwner(resource.data.authorId)
                    && isUnchanged('ideaId')
                    && isUnchanged('orgId')
                    && isUnchanged('authorId')
                    && isUnchanged('authorName')
                    && isUnchanged('createdAt')
                    && isValidLength(request.resource.data.content, 1, 3000);
      allow delete: if isMember(resource.data.orgId)
                    && (isOwner(resource.data.authorId) || isLeader(resource.data.orgId));
    }

    // ══════════════════════════════════════════════════════════════
    // VOTES COLLECTION
    // ══════════════════════════════════════════════════════════════

    match /votes/{voteId} {
      allow read: if isMember(resource.data.orgId);
      allow create: if isMember(request.resource.data.orgId)
                    && isIdeationPhase(request.resource.data.orgId)
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasAll([
                         'ideaId', 'orgId', 'userId', 'createdAt'
                       ]);
      allow update: if false;
      allow delete: if isMember(resource.data.orgId)
                    && isOwner(resource.data.userId)
                    && isIdeationPhase(resource.data.orgId);
    }

    // ══════════════════════════════════════════════════════════════
    // TASKS COLLECTION
    // ══════════════════════════════════════════════════════════════

    match /tasks/{taskId} {
      allow read: if isMember(resource.data.orgId);
      allow create: if isMember(request.resource.data.orgId)
                    && isProjectPhase(request.resource.data.orgId)
                    && request.resource.data.createdBy == request.auth.uid
                    && isValidLength(request.resource.data.title, 1, 200)
                    && request.resource.data.description is string
                    && request.resource.data.description.size() <= 2000
                    && request.resource.data.status == 'todo'
                    && request.resource.data.keys().hasAll([
                         'orgId', 'title', 'description', 'assigneeId',
                         'assigneeName', 'status', 'createdBy',
                         'createdAt', 'updatedAt'
                       ]);
      allow update: if isMember(resource.data.orgId)
                    && isUnchanged('orgId')
                    && isUnchanged('createdBy')
                    && isUnchanged('createdAt')
                    && isValidLength(request.resource.data.title, 1, 200)
                    && request.resource.data.description.size() <= 2000
                    && request.resource.data.status in ['todo', 'in_progress', 'done'];
      allow delete: if isMember(resource.data.orgId)
                    && (isOwner(resource.data.createdBy) || isLeader(resource.data.orgId));
    }
  }
}
