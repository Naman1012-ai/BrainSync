# ============================================================
# BrainSync Standalone Backend Environment Example (.env.example)
# Template for Render Production Environment Variables
# ============================================================

# Server Execution & Port
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Admin Portal Privilege Designation
ADMIN_EMAIL=admin@brainsync.com

# Firebase Admin SDK Credentials (Server-Side Privileged Operations)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"
VITE_FIREBASE_DATABASE_URL=https://your_project-default-rtdb.firebaseio.com

# Google Gemini AI Provider Credentials (Server-Side Only — AI Blueprint Generation Engine)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# UploadThing Storage Provider Credentials (Server-Side Secret Token)
UPLOADTHING_TOKEN=your_uploadthing_secret_token
