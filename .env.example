# BrainSync Environment Configuration

# Firebase Authentication & Realtime Database Credentials
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_DATABASE_URL=https://your_project-default-rtdb.firebaseio.com
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Google Gemini AI Provider Configuration (Server-Side Only)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# UploadThing File Storage Provider Configuration
UPLOADTHING_TOKEN=your_uploadthing_token_id
VITE_UPLOADTHING_APP_ID=your_uploadthing_app_id

# Admin Configuration
VITE_ADMIN_EMAIL=your_admin_email

# Analytics Services (Optional)
VITE_GA_MEASUREMENT_ID=
VITE_POSTHOG_KEY=
VITE_MIXPANEL_TOKEN=
VITE_PLAUSIBLE_DOMAIN=
VITE_CLARITY_ID=
